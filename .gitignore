# Local environment and credentials
/.env
/.env.*
!/.env.example
/credentials.json
/google-credentials.json
**/credentials.local.json

# Generated browser and UI test artifacts
/.tmp/

# Runtime sessions
/storage/sessions/sess_*

# Temporary local debug access and generated database backups
/storage/private/debug-console.enabled
/storage/backups/debug-console/

# Temporary local debug access and generated database backups
/storage/private/debug-console.enabled
/storage/backups/debug-console/

# Private user uploads (keep access-control and placeholder files tracked)
/storage/private/**/*.jpg
/storage/private/**/*.jpeg
/storage/private/**/*.png
/storage/private/**/*.webp
/storage/private/**/*.pdf
