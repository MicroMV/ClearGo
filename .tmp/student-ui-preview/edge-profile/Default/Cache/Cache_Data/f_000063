/* Student portal shell. Existing requirement dialogs retain their workflow styles. */
.student-portal {
    --student-navy: #0b2545;
    --student-blue: #1769aa;
    --student-blue-dark: #11588f;
    --student-blue-soft: #eaf3fb;
    --student-bg: #f4f7fb;
    --student-text: #172b42;
    --student-muted: #63758a;
    --student-border: #dce4ed;
    --student-success: #14745b;
    --student-success-bg: #e5f5ed;
    font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
    -webkit-tap-highlight-color: transparent;
}
.student-portal .portal-icon { width: 22px; height: 22px; flex: 0 0 22px; }
.student-portal .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
.student-portal :is(a, button, summary, select):focus-visible { outline: 3px solid #418fce; outline-offset: 4px; }
.student-portal button, .student-portal select { font: inherit; }
.student-portal button { touch-action: manipulation; }
.student-portal a { text-decoration: none; }
.student-portal .portal-skip-link { position: fixed; top: -100px; left: 16px; z-index: 300; padding: 12px 18px; border-radius: 10px; background: #fff; color: var(--student-text); }
.student-portal .portal-skip-link:focus { top: 12px; }
.student-portal .student-header { background: #fff; }
.student-portal .student-topbar { max-width: 1220px; min-height: 90px; padding: 15px 32px; }
.student-portal .student-brand { gap: 16px; }
.student-portal .student-brand img { width: 48px; height: 48px; flex: 0 0 48px; border-radius: 0; object-fit: contain; }
.student-portal .student-brand strong { color: #0b2545; font-size: 24px; font-weight: 850; line-height: 1.1; letter-spacing: -.7px; }
.student-portal .brand-dot { color: #1769aa; }
.student-portal .student-brand small { margin-top: 5px; color: #63758a; font-size: 10px; font-weight: 650; letter-spacing: 1.2px; line-height: 1; text-transform: uppercase; }
.student-portal .portal-desktop-nav { display: flex; align-items: center; gap: 6px; }
.student-portal .portal-desktop-nav a { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 10px 16px; border-radius: 9px; color: var(--student-muted); font-size: 13px; font-weight: 650; }
.student-portal .portal-desktop-nav .portal-icon { width: 18px; height: 18px; flex-basis: 18px; }
.student-portal .portal-desktop-nav a:hover { background: #f3f8fd; color: var(--student-text); }
.student-portal .portal-desktop-nav a[aria-current] { background: #eaf3fb; color: #155eae; }
.student-portal .header-actions { gap: 14px; }
.student-portal .notification-button { width: 44px; height: 44px; border-color: #dce4ed; border-radius: 50%; }
.student-portal .portal-avatar { display: grid; width: 44px; height: 44px; place-items: center; border: 3px solid #fff; border-radius: 50%; background: #eaf3fb; color: #155eae; font-size: 13px; font-weight: 800; box-shadow: 0 0 0 1px #d7e2ed; }
.student-portal main.student-main { max-width: 1220px; padding: 36px 32px 32px; }
.student-portal .portal-page-heading { display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-bottom: 30px; }
.student-portal .portal-eyebrow, .student-portal .portal-card-eyebrow { margin: 0 0 8px; color: #62748a; font-size: 10px; font-weight: 750; letter-spacing: 1.7px; }
.student-portal .portal-page-heading h1 { margin: 0; color: #172b42; font-size: 36px; line-height: 1.18; font-weight: 750; letter-spacing: -1.4px; }
.student-portal .greeting-dot { color: #1769aa; }
.student-portal .portal-greeting-meta { display: flex; flex-wrap: wrap; gap: 10px; margin: 9px 0 0; color: #62748a; font-size: 13px; }
.student-portal .portal-greeting-meta span { color: #9bacc0; }
.student-portal .portal-period-form { flex: 0 1 330px; min-width: 0; margin: 0; }
.student-portal .portal-period-form label { display: block; margin-bottom: 7px; color: #65777d; font-size: 11px; font-weight: 650; }
.student-portal .portal-period-select { display: flex; align-items: center; gap: 8px; padding-left: 14px; border: 1px solid #d8e3ed; border-radius: 10px; background: #fff; }
.student-portal .portal-period-select .portal-icon { width: 17px; height: 17px; flex-basis: 17px; color: #62748a; }
.student-portal .portal-period-select select { min-width: 0; min-height: 46px; padding-left: 0; border: 0; background: transparent; font-size: 12px; font-weight: 600; }
.student-portal .portal-period-select:focus-within { outline: 3px solid #cfe4fa; }
.student-portal .portal-period-select select:focus { outline: 0; }
.student-portal .portal-archive-notice { display: flex; align-items: center; gap: 9px; margin-bottom: 22px; padding: 11px 14px; border: 1px solid #cde1f6; border-radius: 10px; background: #edf5ff; color: #3f617d; font-size: 12px; }
.student-portal .portal-archive-notice .portal-icon { width: 17px; height: 17px; flex-basis: 17px; }
.student-portal .portal-view { scroll-margin-top: 108px; }
.student-portal .portal-view[hidden], .student-portal [data-station-status][hidden], .student-portal [data-filter-empty][hidden] { display: none !important; }
.student-portal .portal-view:focus { outline: none; }
.student-portal .portal-overview-grid { display: grid; grid-template-columns: minmax(0,1.75fr) minmax(0,1fr); gap: 20px; }
.student-portal .portal-progress-card { position: relative; display: flex; flex-direction: column; min-width: 0; overflow: hidden; border: 1px solid #0b2545; border-radius: 20px; background: #0b2545; color: #fff; }
.student-portal .portal-progress-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 28px 30px 0; }
.student-portal .portal-progress-card .portal-card-eyebrow { margin: 0; color: #9fb8ce; }
.student-portal .portal-live-label { display: flex; align-items: center; gap: 7px; font-size: 10px; color: #c8d9e8; }
.student-portal .portal-live-label i { width: 6px; height: 6px; border-radius: 50%; background: #65b7ed; box-shadow: 0 0 0 4px #65b7ed20; }
.student-portal .portal-progress-content { display: grid; grid-template-columns: minmax(0,1fr) 144px; align-items: center; gap: 26px; flex: 1; padding: 28px 30px 30px; }
.student-portal .portal-progress-content h2 { margin: 0 0 9px; color: #fff; font-size: clamp(23px,2.25vw,29px); line-height: 1.18; letter-spacing: -.9px; font-weight: 700; }
.student-portal .portal-progress-content p { max-width: 270px; margin: 0; color: #c8d9e8; font-size: 12px; line-height: 1.7; }
.student-portal .portal-count { display: flex; align-items: baseline; gap: 8px; margin-top: 22px; }
.student-portal .portal-count strong { color: #fff; font-size: 32px; line-height: 1; font-weight: 650; }
.student-portal .portal-count>span { color: #c8d9e8; font-size: 12px; }
.student-portal .portal-progress-ring { display: grid; width: 144px; height: 144px; padding: 9px; place-items: center; border-radius: 50%; background: conic-gradient(from -90deg, #56a9df calc(var(--progress) * 1%), #26496f 0); }
.student-portal .portal-progress-ring>span { display: flex; width: 100%; height: 100%; align-items: center; justify-content: center; flex-direction: column; border: 5px solid #0b2545; border-radius: 50%; background: #12375f; }
.student-portal .portal-progress-ring strong { color: #fff; font-size: 35px; line-height: 1.1; font-weight: 650; letter-spacing: -1px; }
.student-portal .portal-progress-ring small { margin-left: 2px; color: #b9d7ee; font-size: 17px; }
.student-portal .portal-progress-ring em { margin-top: 6px; color: #b9d7ee; font-size: 10px; font-style: normal; letter-spacing: .3px; }
.student-portal .portal-progress-footer { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 58px; padding: 10px 30px; border-top: 1px solid #ffffff14; background: #ffffff04; }
.student-portal .portal-progress-footer>span { display: flex; align-items: center; gap: 7px; font-size: 11px; color: #c8d9e8; }
.student-portal .portal-progress-footer .portal-icon { width: 16px; height: 16px; flex-basis: 16px; }
.student-portal .portal-progress-footer>a { display: inline-flex; align-items: center; gap: 8px; min-height: 40px; color: #8fc9f1; font-size: 12px; font-weight: 600; }
.student-portal .portal-next-card { position: relative; display: flex; align-items: flex-start; flex-direction: column; min-width: 0; padding: 27px 28px; border: 1px solid #e1e8e5; border-radius: 20px; background: #fff; box-shadow: 0 4px 14px #213b3203; }
.student-portal .portal-next-card .portal-card-eyebrow { margin-bottom: 18px; }
.student-portal .portal-next-icon { display: grid; width: 47px; height: 47px; place-items: center; margin-bottom: 15px; border: 1px solid #cde1f6; border-radius: 14px; background: #edf5ff; color: #155eae; }
.student-portal .portal-next-card h2 { margin: 0; font-size: 23px; letter-spacing: -.7px; }
.student-portal .portal-next-card>p { max-width: 290px; margin: 8px 0 18px; color: #687a80; font-size: 12px; line-height: 1.7; }
.student-portal .portal-action-button { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 44px; padding: 10px 16px; border: 1px solid #cde1f6; border-radius: 9px; background: #edf5ff; color: #155eae; font-size: 12px; font-weight: 700; cursor: pointer; }
.student-portal .portal-action-button:hover { border-color: #aec9df; background: #dcecff; }
.student-portal .portal-action-button .portal-icon { width: 17px; height: 17px; flex-basis: 17px; }
.student-portal .portal-next-card .portal-action-button { margin-top: auto; }
.student-portal .portal-section-title { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin: 0 0 22px; }
.student-portal .portal-section-title .portal-card-eyebrow { display: block; margin: 0 0 7px; }
.student-portal .portal-section-title h2 { margin: 0; font-size: 25px; letter-spacing: -.8px; font-weight: 700; }
.student-portal .portal-section-title p { margin: 6px 0 0; color: var(--student-muted); font-size: 12px; }
.student-portal .portal-quick-title { margin-top: 33px; margin-bottom: 17px; }
.student-portal .portal-quick-title h2 { font-size: 21px; }
.student-portal .portal-shortcut-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 16px; }
.student-portal .portal-shortcut { display: flex; min-width: 0; align-items: center; gap: 13px; padding: 21px 18px; border: 1px solid #e1e7e6; border-radius: 14px; background: #fff; transition: border-color .18s, transform .18s; }
.student-portal .portal-shortcut:hover { transform: translateY(-2px); border-color: #aec9df; }
.student-portal .portal-shortcut>span:nth-child(2) { min-width: 0; flex: 1; }
.student-portal .portal-shortcut strong, .student-portal .portal-shortcut small { display: block; }
.student-portal .portal-shortcut strong { color: var(--student-text); font-size: 13px; font-weight: 650; }
.student-portal .portal-shortcut small { margin-top: 5px; color: var(--student-muted); font-size: 11px; }
.student-portal .portal-shortcut>.portal-icon { width: 16px; height: 16px; flex-basis: 16px; color: #95a4a5; }
.student-portal .portal-shortcut-icon { display: grid; width: 44px; height: 44px; flex: 0 0 44px; place-items: center; border-radius: 12px; }
.student-portal .tone-teal { background: #eaf3fb; color: #1769aa; }
.student-portal .tone-blue { background: #edf3fc; color: #4b7cba; }
.student-portal .tone-lilac { background: #f2effa; color: #8a75b4; }
.student-portal .portal-footer-note { display: flex; align-items: center; gap: 7px; margin-top: 27px; color: #8b9a9e; font-size: 10px; }
.student-portal .portal-footer-note .portal-icon { width: 12px; height: 12px; flex-basis: 12px; }
.student-portal .portal-footer-brand { margin-left: auto; }
.student-portal .portal-attention { margin-top: 26px; }
.student-portal .portal-attention .portal-section-title h2 { font-size: 21px; }
.student-portal .portal-count-badge { display: grid; min-width: 30px; height: 30px; place-items: center; border-radius: 9px; background: #fff0df; color: #9e6a2b; font-size: 12px; font-weight: 700; }
.student-portal .portal-alert { margin-top: 10px; border: 1px solid #ecdfcd; border-radius: 12px; background: #fffcf7; }
.student-portal .portal-alert summary { display: flex; align-items: center; gap: 12px; padding: 15px 18px; list-style: none; cursor: pointer; color: #ab7735; }
.student-portal summary::-webkit-details-marker { display: none; }
.student-portal .portal-alert summary>span { flex: 1; color: #634b2f; }
.student-portal .portal-alert summary strong, .student-portal .portal-alert summary small { display: block; }
.student-portal .portal-alert summary strong { font-size: 12px; }
.student-portal .portal-alert summary small { margin-top: 3px; font-size: 11px; font-weight: 400; }
.student-portal .portal-alert summary>.portal-icon:last-child { width: 16px; height: 16px; flex-basis: 16px; }
.student-portal .portal-alert[open] summary>.portal-icon:last-child { transform: rotate(90deg); }
.student-portal .portal-alert ul { margin: 0; padding: 0 18px 15px 53px; font-size: 12px; }
.student-portal .portal-alert li { padding: 8px 0; overflow-wrap: anywhere; }
.student-portal .portal-alert li small { display: block; margin-top: 4px; color: #8d7761; }
.student-portal .portal-summary-pill { display: flex; flex-shrink: 0; align-items: center; gap: 8px; padding: 9px 12px; border: 1px solid #cde1f6; border-radius: 10px; background: #edf5ff; color: #155eae; font-size: 11px; font-weight: 650; }
.student-portal .portal-summary-pill .portal-icon { width: 16px; height: 16px; flex-basis: 16px; }
.student-portal .portal-clearance-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 20px; }
.student-portal .portal-status-key { display: flex; flex-wrap: wrap; gap: 16px; font-size: 10px; color: #697d7f; }
.student-portal .portal-status-key>span { display: flex; align-items: center; gap: 6px; }
.student-portal .portal-status-key i { width: 6px; height: 6px; border-radius: 50%; }
.student-portal .key-cleared { background: #41ad81; }
.student-portal .key-ready { background: #4b86c3; }
.student-portal .key-upcoming { background: #abb7bc; }
.student-portal .portal-filter-group { display: none; gap: 3px; padding: 4px; border: 1px solid #e0e6e4; border-radius: 10px; background: #ecefed; }
.student-portal.dashboard-enhanced .portal-filter-group { display: flex; }
.student-portal .portal-filter-group button { min-height: 36px; padding: 6px 14px; border: 0; border-radius: 7px; background: transparent; color: #6b7f7c; font-size: 11px; font-weight: 650; cursor: pointer; }
.student-portal .portal-filter-group button.is-active { background: #fff; color: #155eae; box-shadow: 0 1px 4px #17324d0a; }
.student-portal .portal-station-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 15px; margin: 0; padding: 0; list-style: none; }
.student-portal .portal-station-card { position: relative; min-width: 0; padding: 20px; border: 1px solid #e0e7e5; border-radius: 15px; background: #fff; transition: box-shadow .18s, border-color .18s; }
.student-portal .portal-station-card:has(.portal-station-open):hover { border-color: #abcbbd; box-shadow: 0 5px 20px #204b3808; }
.student-portal .portal-station-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 17px; }
.student-portal .portal-station-icon { display: grid; width: 42px; height: 42px; place-items: center; border-radius: 11px; background: #edf4fc; color: #477daf; }
.student-portal .portal-office-step { color: #647a79; font-size: 10px; }
.student-portal .portal-station-card h3 { margin: 0 0 16px; font-size: 15px; font-weight: 650; }
.student-portal .portal-station-bottom { display: flex; align-items: center; justify-content: space-between; gap: 7px; }
.student-portal .portal-station-bottom>.portal-icon { width: 16px; height: 16px; flex-basis: 16px; color: #94a7a2; }
.student-portal .portal-station-status { display: flex; align-items: center; gap: 5px; color: #477daf; font-size: 10px; font-weight: 600; }
.student-portal .portal-station-status .portal-icon { width: 13px; height: 13px; flex-basis: 13px; }
.student-portal .portal-station-open { position: absolute; inset: 0; width: 100%; height: 100%; padding: 0; border: 0; border-radius: inherit; background: transparent; cursor: pointer; }
.student-portal .portal-station-card.is-cleared { border-color: #dbe8de; }
.student-portal .is-cleared .portal-station-icon { background: #edf7ef; color: #478760; }
.student-portal .is-cleared .portal-station-status { color: #43805e; }
.student-portal .portal-station-card.is-upcoming { background: #f0f3f3; border-color: #e4e9e7; }
.student-portal .is-upcoming .portal-station-icon { color: #98a8aa; background: #e7eded; }
.student-portal .is-upcoming h3 { color: #5e7074; }
.student-portal .is-upcoming .portal-station-status { color: #607477; }
.student-portal .portal-station-card.is-attention { border-color: #eed3c7; }
.student-portal .is-attention .portal-station-icon { background: #fff2e9; color: #b77d4f; }
.student-portal .is-attention .portal-station-status { color: #ac663e; }
.student-portal .portal-record-details { margin-top: 22px; color: #829492; font-size: 11px; }
.student-portal .portal-record-details summary { display: inline-flex; align-items: center; gap: 7px; min-height: 44px; padding: 5px 0; cursor: pointer; }
.student-portal .portal-record-details .portal-icon { width: 14px; height: 14px; flex-basis: 14px; }
.student-portal .portal-record-details p { margin: 0; padding-bottom: 12px; overflow-wrap: anywhere; }
.student-portal .portal-record-details[open] summary>.portal-icon:last-child { transform: rotate(90deg); }
.student-portal .portal-filter-empty { margin-top: 25px; padding: 24px; text-align: center; font-size: 13px; color: var(--student-muted); }
.student-portal .portal-empty-state { display: flex; align-items: center; flex-direction: column; justify-content: center; min-height: 220px; padding: 35px 24px; border: 1px dashed #cdddea; border-radius: 16px; background: #ffffff80; text-align: center; }
.student-portal .portal-empty-state>.portal-icon { width: 35px; height: 35px; margin-bottom: 17px; color: #7899b5; }
.student-portal .portal-empty-state h3 { color: #315673; font-size: 16px; }
.student-portal .portal-empty-state p { max-width: 330px; margin: 8px 0 0; color: #71879b; font-size: 12px; }
.student-portal .portal-scanner-card { display: flex; align-items: center; gap: 19px; padding: 24px; margin-bottom: 22px; border: 1px solid #cde1f6; border-radius: 16px; background: #edf5ff; }
.student-portal .portal-scanner-icon { display: grid; width: 60px; height: 60px; flex: 0 0 60px; place-items: center; border: 1px solid #cde1f6; border-radius: 15px; background: #fff; color: #155eae; }
.student-portal .portal-scanner-icon .portal-icon { width: 30px; height: 30px; }
.student-portal .portal-scanner-card>div { flex: 1; }
.student-portal .portal-scanner-card h3 { font-size: 18px; }
.student-portal .portal-scanner-card p { margin: 6px 0 0; color: #587086; font-size: 12px; }
.student-portal .portal-scanner-card .portal-action-button { border-color: #155eae; background: #155eae; color: #fff; }
.student-portal .portal-event-list { display: grid; gap: 12px; list-style: none; margin: 0; padding: 0; }
.student-portal .portal-event-card { display: flex; min-width: 0; align-items: center; gap: 17px; padding: 21px; border: 1px solid #e1e8e6; border-radius: 14px; background: #fff; }
.student-portal .portal-event-date { display: flex; flex-direction: column; align-items: center; justify-content: center; width: 54px; height: 60px; flex: 0 0 54px; border: 1px solid #e3ebe7; border-radius: 11px; background: #f6f9f7; }
.student-portal .portal-event-date span { color: #62776c; font-size: 10px; text-transform: uppercase; }
.student-portal .portal-event-date strong { margin-top: 1px; color: #315e4e; font-size: 24px; font-weight: 650; line-height: 1.25; }
.student-portal .portal-event-card>div { min-width: 0; flex: 1; }
.student-portal .portal-event-card h3 { overflow-wrap: anywhere; font-size: 14px; }
.student-portal .portal-event-card p { margin: 5px 0 0; color: #61796e; font-size: 11px; }
.student-portal .portal-event-status { display: flex; align-items: center; gap: 6px; padding: 7px 10px; border-radius: 8px; background: #f0f3f3; color: #596f64; font-size: 10px; font-weight: 600; }
.student-portal .portal-event-status .portal-icon { width: 13px; height: 13px; flex-basis: 13px; }
.student-portal .portal-event-status.is-present { background: #eaf6ed; color: #4f865f; }
.student-portal .portal-account-layout { display: grid; grid-template-columns: minmax(0,1.2fr) minmax(0,1fr); gap: 24px; }
.student-portal .portal-account-card { overflow: hidden; border: 1px solid #d8e3ed; border-radius: 18px; background: #fff; }
.student-portal .portal-account-banner { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 26px 28px; background: #eaf3fb; }
.student-portal .portal-profile-avatar { display: grid; width: 58px; height: 58px; place-items: center; border: 4px solid #fff; border-radius: 17px; background: #0b2545; color: #fff; font-size: 20px; font-weight: 750; box-shadow: 0 3px 8px #17324d0b; }
.student-portal .portal-student-label { padding: 6px 10px; border: 1px solid #bfd3e5; border-radius: 7px; color: #47718f; font-size: 9px; font-weight: 650; letter-spacing: 1px; }
.student-portal .portal-account-info { padding: 26px 28px; }
.student-portal .portal-account-info h3 { font-size: 22px; font-weight: 700; }
.student-portal .portal-account-info>p { margin: 6px 0 25px; color: #83928c; font-size: 12px; }
.student-portal .portal-account-info dl { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin: 0; }
.student-portal .portal-account-info dl>div { min-width: 0; }
.student-portal .portal-account-info dl>div:nth-child(n+3) { grid-column: 1/-1; }
